{
  "name": "axozap-games",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && vite build",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types",
    "deploy:all": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.487.0",
    "hono": "^4.13.1",
    "google-auth-library": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "typescript": "^5.5.2",
    "vite": "^6.3.5",
    "wrangler": "^4.134.0"
  }
}
