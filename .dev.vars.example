# Wrangler reads the Access audience from wrangler.jsonc.
# For separate Access applications, set these to each app's audience:
# CF_ACCESS_AUD_GD=...
# CF_ACCESS_AUD_CELESTE=...
# Optional integrations formerly configured on the Demons Worker:
# GOOGLE_SERVICE_ACCOUNT=...
# GOOGLE_SHEET_ID=...
# GOOGLE_SHEET_NAME=...
# GDDL_API_TOKEN=...
